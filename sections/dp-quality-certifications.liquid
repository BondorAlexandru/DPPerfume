      "type": "range",
      "id": "padding_top",
      "label": "Padding sus secțiune (px)",
      "min": 0, "max": 160, "step": 8,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding jos secțiune (px)",
      "min": 0, "max": 160, "step": 8,
      "default": 80
    }

  ],

  "blocks": [
    {
      "type": "cert_card",
      "name": "Card certificare",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Iconiță",
          "options": [
