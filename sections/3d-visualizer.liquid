{{ 'section-3d-visualizer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

{%- assign first_block = section.blocks | first -%}
{%- assign block_count = section.blocks.size -%}

<div
  class="visualizer-3d"
  id="Visualizer-{{ section.id }}"
  style="--viewer-bg: {{ section.settings.background_color }};"
>
  <div class="">
    <div class="visualizer-3d__wrapper">
      <div class="visualizer-3d__inner">
        <div class="visualizer-3d__viewer-col">
          {%- if block_count > 1 -%}
            <div class="visualizer-3d__nav">
              {%- for block in section.blocks -%}
                <button
                  class="visualizer-3d__nav-btn{% if forloop.first %} visualizer-3d__nav-btn--active{% endif %}"
                  data-model-url="{{ block.settings.model_url }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label }}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div
            class="visualizer-3d__viewer"
            {%- if section.settings.poster_image -%}
              style="background-image: url('{{ section.settings.poster_image | image_url: width: 1200 }}'); background-size: contain; background-position: center; background-repeat: no-repeat;"
            {%- endif -%}
          >
            <canvas id="Canvas-{{ section.id }}"></canvas>
            <div class="visualizer-3d__spinner" id="Spinner-{{ section.id }}">
              <div class="visualizer-3d__spinner-ring"></div>
            </div>
          </div>
        </div>

        <div class="visualizer-3d__text-col">
          <div class="titles">
            {%- if section.settings.subheading != blank -%}
              <p class="subtitle">{{ section.settings.subheading }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h1 class="h1">{{ section.settings.heading }}</h1>
            {%- endif -%}
          </div>
          {%- if section.settings.text != blank -%}
            <div class="rte">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a
              {%- if section.settings.button_link != blank -%}
                href="{{ section.settings.button_link }}"
              {%- endif -%}
              class="button"
            >
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.176.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.176.0/examples/jsm/"
    }
  }
</script>

<script type="module">
  import { ThreeViewer } from '{{ '3d-viewer-engine.js' | asset_url }}';

  (function() {
    var sectionEl = document.getElementById('Visualizer-{{ section.id }}');
    if (!sectionEl) return;

    var canvas = document.getElementById('Canvas-{{ section.id }}');
    var spinner = document.getElementById('Spinner-{{ section.id }}');
    var navButtons = sectionEl.querySelectorAll('.visualizer-3d__nav-btn');

    if (!canvas) return;

    var viewer = new ThreeViewer(canvas, {
      bgColor: '{{ section.settings.background_color | default: "#F8F7F5" }}',
      autoRotate: {{ section.settings.auto_rotate | default: true }},
      rotationSpeed: {{ section.settings.rotation_speed | default: 60 | divided_by: 15.0 }},
      rotationDelay: {{ section.settings.rotation_delay | default: 3000 }},
      cameraControls: {{ section.settings.camera_controls | default: true }},
      exposure: {{ section.settings.exposure | default: 1.0 }},
      hdrUrl: '{{ section.settings.hdr_environment_url | default: "" }}',
      bloomIntensity: {{ section.settings.bloom_intensity | default: 0.3 }},
      onLoad: function() {
        if (spinner) spinner.style.display = 'none';
        canvas.parentElement.style.backgroundImage = 'none';
      }
    });

    {% if first_block and first_block.settings.model_url != blank %}
      viewer.loadModel('{{ first_block.settings.model_url }}').catch(function(err) {
        console.error('Failed to load initial model:', err);
        if (spinner) spinner.style.display = 'none';
      });
    {% else %}
      if (spinner) spinner.style.display = 'none';
    {% endif %}

    if (navButtons.length > 0) {
      navButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          var modelUrl = this.getAttribute('data-model-url');
          if (!modelUrl) return;

          navButtons.forEach(function(btn) {
            btn.classList.remove('visualizer-3d__nav-btn--active');
          });
          this.classList.add('visualizer-3d__nav-btn--active');

          spinner.style.display = 'flex';
          canvas.parentElement.style.backgroundImage = 'none';

          viewer.loadModel(modelUrl).catch(function(err) {
            console.error('Failed to load model:', err);
          }).finally(function() {
            spinner.style.display = 'none';
          });
        });
      });
    }

    // Cleanup on section unload
    document.addEventListener('shopify:section:unload', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        viewer.dispose();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "3D Visualizer",
  "tag": "section",
  "class": "visualizer-3d-section spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "3D Product Viewer"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Explore our product in 3D. Rotate, zoom, and interact with the model.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Viewer appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Viewer background color",
      "default": "#F8F7F5"
    },
    {
      "type": "header",
      "content": "3D Model controls"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate",
      "default": true
    },
    {
      "type": "text",
      "id": "rotation_delay",
      "label": "Auto-rotate delay (ms)",
      "default": "3000",
      "info": "Time before auto-rotation resumes after user interaction"
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Rotation speed (degrees/sec)",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 60,
      "info": "How fast the model rotates. Default: 60°/sec"
    },
    {
      "type": "checkbox",
      "id": "camera_controls",
      "label": "Enable camera controls (zoom, rotate)",
      "default": true
    },
    {
      "type": "header",
      "content": "Lighting & rendering"
    },
    {
      "type": "range",
      "id": "exposure",
      "label": "Exposure",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "default": 1.2,
      "info": "Controls overall brightness. Higher values make glass more visible."
    },
    {
      "type": "range",
      "id": "bloom_intensity",
      "label": "Bloom intensity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3,
      "info": "Glow on bright highlights. Creates sparkle on glass and metallic surfaces."
    },
    {
      "type": "text",
      "id": "hdr_environment_url",
      "label": "HDR environment image URL",
      "info": "Upload an .hdr file to Shopify Files (or host externally) and paste the URL. Critical for realistic glass reflections and refractions."
    },
    {
      "type": "header",
      "content": "Loading"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster image",
      "info": "Static image shown while the 3D model loads"
    },
    {
      "type": "header",
      "content": "Section margin"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "Extra small" },
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "m",
      "label": "Top margin"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        { "value": "no-indent", "label": "None" },
        { "value": "xs", "label": "Extra small" },
        { "value": "s", "label": "Small" },
        { "value": "m", "label": "Medium" },
        { "value": "l", "label": "Large" },
        { "value": "xl", "label": "Extra large" }
      ],
      "default": "m",
      "label": "Bottom margin"
    }
  ],
  "blocks": [
    {
      "type": "model_item",
      "name": "3D Model",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Model"
        },
        {
          "type": "text",
          "id": "model_url",
          "label": "GLB file URL",
          "info": "Upload a .glb file to Shopify Settings > Files, then paste the URL here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "3D Visualizer",
      "blocks": [
        {
          "type": "model_item",
          "settings": {
            "label": "Model 1"
          }
        }
      ]
    }
  ]
}
{% endschema %}
