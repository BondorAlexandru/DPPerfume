{%- style -%}
  .store-locator-{{ section.id }} {
    padding: 60px 20px;
  }
  .store-locator-{{ section.id }} .store-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    gap: 20px;
  }
  .store-locator-{{ section.id }} .store-col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  @media screen and (max-width: 1200px) {
    .store-locator-{{ section.id }} .store-grid {
      display: block;
      column-count: 2;
      column-gap: 20px;
    }
    .store-locator-{{ section.id }} .store-col {
      display: contents;
    }
  }
  @media screen and (max-width: 750px) {
    .store-locator-{{ section.id }} .store-grid {
      column-count: 1;
    }
  }
  .store-locator-{{ section.id }} .city-group {
    break-inside: avoid;
    margin-bottom: 20px;
    background: #F5F5F5;
    border-radius: 20px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .store-locator-{{ section.id }} .city-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
  }
  .store-locator-{{ section.id }} .city-name {
    font-size: 24px;
    font-weight: 300;
    color: black;
    font-family: 'Open Sans', sans-serif;
  }
  .store-locator-{{ section.id }} .city-toggle {
    width: 25px;
    height: 25px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 18px;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    color: black;
  }
  .store-locator-{{ section.id }} .toggle-minus { display: none; }
  .store-locator-{{ section.id }} .toggle-plus { display: block; }
  .store-locator-{{ section.id }} .city-group.open .toggle-minus { display: block; }
  .store-locator-{{ section.id }} .city-group.open .toggle-plus { display: none; }
  .store-locator-{{ section.id }} .city-stores {
    display: none;
    flex-direction: column;
  }
  .store-locator-{{ section.id }} .city-group.open .city-stores {
    display: flex;
  }
  .store-locator-{{ section.id }} .store-item {
    padding: 15px;
    border-bottom: 0.5px solid black;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .store-locator-{{ section.id }} .store-item:last-child {
    border-bottom: none;
  }
  .store-locator-{{ section.id }} .store-name {
    font-size: 16px;
    font-weight: 400;
    color: black;
    font-family: 'Open Sans', sans-serif;
  }
  .store-locator-{{ section.id }} .store-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .store-locator-{{ section.id }} .store-info-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .store-locator-{{ section.id }} .store-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-top: 3px;
  }
  .store-locator-{{ section.id }} .store-icon svg {
    width: 100%;
    height: 100%;
  }
  .store-locator-{{ section.id }} .store-text {
    flex: 1;
    font-size: 14px;
    font-weight: 400;
    color: black;
    font-family: 'Open Sans', sans-serif;
    line-height: 1.4;
  }
  .store-locator-{{ section.id }} .store-text a {
    color: black;
    text-decoration: none;
  }
  .store-locator-{{ section.id }} .store-text a:hover {
    text-decoration: underline;
  }
{%- endstyle -%}

<div class="store-locator-{{ section.id }}">
  <div class="store-grid" id="StoreGrid-{{ section.id }}">
    {%- assign city_started = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'city' -%}
        {%- if city_started -%}
          </div></div>
        {%- endif -%}
        {%- assign city_started = true -%}
        <div class="city-group {% if block.settings.open_by_default %}open{% endif %}" {{ block.shopify_attributes }}>
          <div class="city-header" onclick="this.parentElement.classList.toggle('open')">
            <span class="city-name">{{ block.settings.city_name }}</span>
            <div class="city-toggle">
              <span class="toggle-plus">+</span>
              <span class="toggle-minus">—</span>
            </div>
          </div>
          <div class="city-stores">
      {%- elsif block.type == 'store' -%}
            <div class="store-item" {{ block.shopify_attributes }}>
              <div class="store-name">{{ block.settings.store_name }}</div>
              <div class="store-info">
                {%- if block.settings.store_phone != blank -%}
                  <div class="store-info-row">
                    <div class="store-icon">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                      </svg>
                    </div>
                    <div class="store-text">
                      <a href="tel:{{ block.settings.store_phone | remove: ' ' | remove: '.' }}">{{ block.settings.store_phone }}</a>
                    </div>
                  </div>
                {%- endif -%}
                {%- if block.settings.store_address != blank -%}
                  <div class="store-info-row">
                    <div class="store-icon">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                      </svg>
                    </div>
                    <div class="store-text">{{ block.settings.store_address }}</div>
                  </div>
                {%- endif -%}
              </div>
            </div>
      {%- endif -%}
    {%- endfor -%}
    {%- if city_started -%}
      </div></div>
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    var grid = document.getElementById('StoreGrid-{{ section.id }}');
    if (!grid) return;
    var groups = Array.from(grid.querySelectorAll(':scope > .city-group'));
    if (groups.length < 2) return;

    var colSize = Math.ceil(groups.length / 3);
    for (var c = 0; c < 3; c++) {
      var col = document.createElement('div');
      col.className = 'store-col';
      var start = c * colSize;
      var end = Math.min(start + colSize, groups.length);
      for (var i = start; i < end; i++) {
        col.appendChild(groups[i]);
      }
      grid.appendChild(col);
    }
  })();
</script>

{% schema %}
{
  "name": "Store Locator",
  "tag": "section",
  "class": "store-locator-section",
  "max_blocks": 50,
  "settings": [],
  "blocks": [
    {
      "type": "city",
      "name": "City",
      "settings": [
        {
          "type": "text",
          "id": "city_name",
          "label": "City name",
          "default": "City"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "text",
          "id": "store_name",
          "label": "Store name",
          "default": "Store name"
        },
        {
          "type": "text",
          "id": "store_phone",
          "label": "Phone"
        },
        {
          "type": "textarea",
          "id": "store_address",
          "label": "Address"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store Locator",
      "blocks": [
        { "type": "city", "settings": { "city_name": "București", "open_by_default": true } },
        { "type": "store", "settings": { "store_name": "Veranda Mall", "store_phone": "0744 456 883", "store_address": "Str Ziduri Mosi 23 (nivelul 0 parter, in fata caselor de marcat Carrefour)" } }
      ]
    }
  ]
}
{% endschema %}
