{%- style -%}
  .store-locator-{{ section.id }} {
    padding: 60px 20px;
  }
  .store-locator-{{ section.id }} .store-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    gap: 20px;
  }
  .store-locator-{{ section.id }} .store-col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  @media screen and (max-width: 1200px) {
    .store-locator-{{ section.id }} .store-grid {
      display: block;
      column-count: 2;
      column-gap: 20px;
    }
    .store-locator-{{ section.id }} .store-col {
      display: contents;
    }
  }
  @media screen and (max-width: 750px) {
    .store-locator-{{ section.id }} .store-grid {
      column-count: 1;
    }
  }
  .store-locator-{{ section.id }} .city-group {
    break-inside: avoid;
    margin-bottom: 20px;
    border: 0.5px solid black;
    border-radius: 10px;
    padding: 0 15px;
  }
  .store-locator-{{ section.id }} .city-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    cursor: pointer;
    user-select: none;
    background: none;
    border: none;
    width: 100%;
  }
  .store-locator-{{ section.id }} .city-name {
    font-size: 18px;
    font-weight: 500;
    color: black;
    margin: 0;
  }
  .store-locator-{{ section.id }} .city-toggle {
    width: 24px;
    height: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 18px;
    font-weight: 300;
    color: black;
    flex-shrink: 0;
  }
  .store-locator-{{ section.id }} .toggle-minus { display: none; }
  .store-locator-{{ section.id }} .toggle-plus { display: block; }
  .store-locator-{{ section.id }} .city-group.open .toggle-minus { display: block; }
  .store-locator-{{ section.id }} .city-group.open .toggle-plus { display: none; }
  .store-locator-{{ section.id }} .city-stores {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 350ms ease-in-out;
  }
  .store-locator-{{ section.id }} .city-group.open .city-stores {
    grid-template-rows: 1fr;
  }
  .store-locator-{{ section.id }} .city-stores-inner {
    overflow: hidden;
    transition: padding 350ms ease-in-out;
    padding: 0;
  }
  .store-locator-{{ section.id }} .city-group.open .city-stores-inner {
    padding: 0 0 15px;
  }
  .store-locator-{{ section.id }} .store-item {
    padding: 15px;
    border-bottom: 0.5px solid black;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .store-locator-{{ section.id }} .store-item:last-child {
    border-bottom: none;
  }
  .store-locator-{{ section.id }} .store-name {
    font-size: 16px;
    font-weight: 400;
    color: black;
    font-family: 'Open Sans', sans-serif;
  }
  .store-locator-{{ section.id }} .store-info {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .store-locator-{{ section.id }} .store-info-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .store-locator-{{ section.id }} .store-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-top: 3px;
  }
  .store-locator-{{ section.id }} .store-icon svg {
    width: 100%;
    height: 100%;
  }
  .store-locator-{{ section.id }} .store-text {
    flex: 1;
    font-size: 14px;
    font-weight: 400;
    color: black;
    font-family: 'Open Sans', sans-serif;
    line-height: 1.4;
  }
  .store-locator-{{ section.id }} .store-text a {
    color: black;
    text-decoration: none;
  }
  .store-locator-{{ section.id }} .store-text a:hover {
    text-decoration: underline;
  }
{%- endstyle -%}

