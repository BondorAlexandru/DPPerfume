{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{- 'component-accordion.css' | asset_url | stylesheet_tag -}}
{{- 'component-list-menu.css' | asset_url | stylesheet_tag -}}
{{- 'component-list-payment.css' | asset_url | stylesheet_tag -}}
{{- 'component-list-social.css' | asset_url | stylesheet_tag -}}
{{ 'component-rte.css' | asset_url | stylesheet_tag -}}
{{- 'disclosure.css' | asset_url | stylesheet_tag }}

<script src='{{ 'footer.js' | asset_url }}' defer='defer'></script>

{%- style -%}
	{% render 'section-padding' %}
{%- endstyle -%}

{% assign copyright_bottom = section.settings.copyright_bottom %}
{% assign copyright_position = 'middle' %}
{% if copyright_bottom %}
	{% assign copyright_position = 'bottom' %}
{% endif %}

{% assign template_base = template | split: '.' | first %}

{% unless template_base == 'customers/login'
	or template_base == 'customers/register'
%}
	{% assign is_footer_content_middle = false %}

	{% if section.settings.enable_country_selector
		or section.settings.enable_language_selector
		or section.settings.payment_enable
	%}
		{% assign is_footer_content_middle = true %}
	{% endif %}

	{% liquid
		assign enable_logo = true
		assign center_subscribe = false
		assign hide_last_block = false

		if settings.home_page_slider and template.name == 'index'
			assign enable_logo = false
		endif

		if settings.enable_home_footer_logo and template.name == 'index'
			assign enable_logo = true
		endif

		if section.settings.enable_subscribe and settings.home_page_slider and template.name == 'index'
			assign center_subscribe = true
		endif

		if copyright_position == 'middle' and is_footer_content_middle == false
			assign hide_last_block = true
		endif
	%}

	<footer class='footer color-{{ section.settings.color_scheme }} background {% if section.settings.show_border %} footer--border {% endif %} section-{{ section.id }}-padding{% if center_subscribe %} footer--center_subscribe{% if hide_last_block %} footer--center_subscribe__four-parts{% endif %}{% endif %}'>

		<div class='footer__editorial-statement'>
			<span class='footer__editorial-eyebrow'>De peste 20 de ani</span>
			<p class='footer__editorial-headline'>Rafinament &middot; Autenticitate &middot; Pasiune</p>
		</div>

		{% if center_subscribe %}
			<div class='newsletter__form footer--newsletter__form--center container'>
				<h2 class='newsletter__title title--section-m-none {{ section.settings.heading_size }}'>
					{{ section.settings.heading }}
				</h2>
				{% form 'customer', class: 'newsletter-form' %}
					{%- if section.settings.subscribe_heading != blank -%}
						<h3 class='newsletter__title h2 title--section title--section-m-none'>
							{{ section.settings.subscribe_heading }}
						</h3>
					{%- endif -%}
					{%- if section.settings.subscribe_text != blank -%}
						<div class='newsletter__text secondary_text'>
							{{ section.settings.subscribe_text }}
						</div>
					{%- endif -%}
					<div class='newsletter-form__inner'>
						<input
							dir="ltr"
							type='hidden'
							name='contact[tags]'
							value='newsletter'
						>
						<div class='newsletter-form__field-wrapper'>
							<div class='field'>
								<input
									dir="ltr"
									id='NewsletterForm--{{ section.id }}'
									type='email'
									name='contact[email]'
									class='field__input field'
									value='{{ form.email }}'
									aria-required='true'
									autocorrect='off'
									autocapitalize='off'
									autocomplete='email'
									pattern='[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$'
									{% if form.errors %}
										autofocus
										aria-invalid='true'
										aria-describedby='Newsletter-error--{{ section.id }}'
									{% elsif form.posted_successfully? %}
										aria-describedby='Newsletter-success--{{ section.id }}'
									{% endif %}
									placeholder='{{ 'newsletter.label' | t }}'
									required
								>
								<label
									class='visually-hidden'
									for='NewsletterForm--{{ section.id }}'
								>
									{{ 'newsletter.label' | t }}
								</label>
							</div>
							{%- if form.errors -%}
								<small
									class='newsletter-form__message form__message'
									id='Newsletter-error--{{ section.id }}'
								>
									{%- render 'icon-error' -%}
									{{- form.errors.translated_fields.email | capitalize }}
									{{ form.errors.messages.email -}}
								</small>
							{%- endif -%}
							<button
								type='submit'
								class='newsletter__button button button--tertiary'
								name='commit'
							>
								{{ 'newsletter.button_label' | t }}
							</button>
						</div>
					</div>
					{%- if form.posted_successfully? -%}
						<h3
							class='newsletter-form__message newsletter-form__message--success form__message'
							id='Newsletter-success--{{ section.id }}'
							tabindex='-1'
							autofocus
						>
							{{- 'newsletter.success' | t }}
						</h3>
					{%- endif -%}
				{% endform %}
			</div>
		{% endif %}

		<div class='footer__content-top container'>
			{%- if section.settings.logo_layout == 'center' and enable_logo -%}
				<div class='footer__logo-link--center-wrapper'>
					<a
						href='{{ routes.root_url }}'
						class='footer__logo-link footer__logo-link--center link link--text focus-inset'
					>
						{%- if section.settings.logo != blank -%}
							{%- assign logo_height = section.settings.logo_width
								| divided_by: section.settings.logo.aspect_ratio
							-%}
							{%- assign logo_alt = section.settings.logo.alt
								| default: shop.name
								| escape
							-%}
							{%- assign image_size_2x = section.settings.logo_width
								| times: 2
							-%}
							{% capture srcset %}
								{{ section.settings.logo | image_url: width: section.settings.logo_width }}, {{ section.settings.logo | image_url: width: image_size_2x }} 2x
							{% endcapture %}
							{{
								section.settings.logo
								| image_url: width: section.settings.logo_width
								| image_tag:
									class: 'footer__logo header__heading-logo',
									srcset: srcset,
									height: logo_height,
									width: section.settings.logo_width,
									alt: logo_alt
							}}
							{%- if section.settings.logo_2 != blank -%}
								{% capture srcset %}
								{{ section.settings.logo_2 | image_url: width: section.settings.logo_width }}, {{ section.settings.logo_2 | image_url: width: image_size_2x }} 2x
							{% endcapture %}
								{{
									section.settings.logo_2
									| image_url: width: section.settings.logo_width
									| image_tag:
										class: 'footer__logo header__heading-logo footer__logo--overlay header__heading-logo--overlay',
										srcset: srcset,
										height: logo_height,
										width: section.settings.logo_width,
										alt: logo_alt
								}}
							{%- endif -%}
						{%- else -%}
							<span class='h6 h7'>{{ shop.name }}</span>
						{%- endif -%}
					</a>
				</div>
			{% endif %}

			{% comment %}
				{% if center_subscribe %}
					<div class="newsletter__form footer--newsletter__form--center">
						<h2 class="newsletter__title title--section-m-none {{ section.settings.heading_size }}">
							{{ section.settings.heading }}
						</h2>
							{% form 'customer', class: 'newsletter-form' %}
								{% if section.settings.subscribe_heading != blank %}
									<h3 class="newsletter__title h4 title--section title--section-m-none">
										{{ section.settings.subscribe_heading }}
									</h3>
								{% endif %}
								<div class="newsletter__text rte">
									{{ section.settings.subscribe_text }}
								</div>
								<div class="newsletter-form__inner">
									<input
										type="hidden"
										name="contact[tags]"
										value="newsletter"
									>
									<div class="newsletter-form__field-wrapper">
										<div class="field">
											<input
												id="NewsletterForm--{{ section.id }}"
												type="email"
												name="contact[email]"
												class="field__input field"
												value="{{ form.email }}"
												aria-required="true"
												autocorrect="off"
												autocapitalize="off"
												autocomplete="email"
												pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
												{% if form.errors %}
													autofocus
													aria-invalid="true"
													aria-describedby="Newsletter-error--{{ section.id }}"
												{% elsif form.posted_successfully? %}
													aria-describedby="Newsletter-success--{{ section.id }}"
												{% endif %}
												placeholder="{{ 'newsletter.label' | t }}"
												required
											>
											<label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
												{{ 'newsletter.label' | t }}
											</label>
										</div>
										{%- if form.errors -%}
											<small
												class="newsletter-form__message form__message"
												id="Newsletter-error--{{ section.id }}"
											>
												{%- render 'icon-error' -%}
												{{- form.errors.translated_fields.email | capitalize }}
												{{ form.errors.messages.email -}}
											</small>
										{%- endif -%}
										<button
											type="submit"
											class="newsletter__button button button--tertiary"
											name="commit"
										>
											{{ 'newsletter.button_label' | t }}
										</button>
									</div>
								</div>
								{%- if form.posted_successfully? -%}
									<h3
										class="newsletter-form__message newsletter-form__message--success form__message"
										id="Newsletter-success--{{ section.id }}"
										tabindex="-1"
										autofocus
									>
										{% render 'icon-success' -%}
										{{- 'newsletter.success' | t }}
									</h3>
								{%- endif -%}
							{% endform %}
					</div>
				{% endif %}
			{% endcomment %}

			{%- if section.blocks.size > 0
				or section.settings.logo != blank
				or section.settings.description != blank
				or section.settings.enable_subscribe
			-%}
				<div class='footer__blocks-container footer__blocks-container--{{ section.settings.logo_layout }} section-{{ section.id }}-padding '>
					<div class='footer__blocks-wrapper {% if copyright_bottom == false %}with-padding{% endif %}'>
						<div
							class='footer-block footer-block--logo section-{{ section.id }}-padding{% if enable_logo == false %} footer-block--logo--hidden{% endif %}'
							{{ block.shopify_attributes }}
						>
							{% if enable_logo %}
								<a
									href='{{ routes.root_url }}'
									class='footer__logo-link link link--text focus-inset'
								>
									{%- if section.settings.logo != blank -%}
										{%- assign logo_height = section.settings.logo_width
											| divided_by: section.settings.logo.aspect_ratio
										-%}
										{%- assign logo_alt = section.settings.logo.alt
											| default: shop.name
											| escape
										-%}
										{%- assign image_size_2x = section.settings.logo_width
											| times: 2
										-%}
										{% capture srcset %}
											{{ section.settings.logo | image_url: width: section.settings.logo_width }}, {{ section.settings.logo | image_url: width: image_size_2x }} 2x
										{% endcapture %}
										{{
											section.settings.logo
											| image_url: width: section.settings.logo_width
											| image_tag:
												class: 'footer__logo header__heading-logo',
												srcset: srcset,
												height: logo_height,
												width: section.settings.logo_width,
												alt: logo_alt
										}}
										{%- if section.settings.logo_2 != blank -%}
											{% capture srcset %}
											{{ section.settings.logo_2 | image_url: width: section.settings.logo_width }}, {{ section.settings.logo_2 | image_url: width: image_size_2x }} 2x
										{% endcapture %}
											{{
												section.settings.logo_2
												| image_url: width: section.settings.logo_width
												| image_tag:
													class: 'footer__logo header__heading-logo footer__logo--overlay header__heading-logo--overlay',
													srcset: srcset,
													height: logo_height,
													width: section.settings.logo_width,
													alt: logo_alt
											}}
										{%- endif -%}
									{%- else -%}
										<span class='h6 h7'>{{ shop.name }}</span>
									{%- endif -%}
								</a>
							{% endif %}
							{% if section.settings.description != blank %}
								<div class='footer-block__text secondary_text'>
									{{ section.settings.description }}
								</div>
							{% endif %}

							<div class='footer__social-icons'>
								{%- if settings.social_instagram_link != blank -%}
									<a href='{{ settings.social_instagram_link }}' class='footer__social-icon' target='_blank' rel='noopener' aria-label='Instagram'>
										<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor' width='13' height='13'><path d='M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z'/></svg>
									</a>
								{%- endif -%}
								{%- if settings.social_facebook_link != blank -%}
									<a href='{{ settings.social_facebook_link }}' class='footer__social-icon' target='_blank' rel='noopener' aria-label='Facebook'>
										<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor' width='13' height='13'><path d='M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z'/></svg>
									</a>
								{%- endif -%}
								{%- if settings.social_tiktok_link != blank -%}
									<a href='{{ settings.social_tiktok_link }}' class='footer__social-icon' target='_blank' rel='noopener' aria-label='TikTok'>
										<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor' width='13' height='13'><path d='M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9.05a8.16 8.16 0 004.77 1.52V7.12a4.85 4.85 0 01-1-.43z'/></svg>
									</a>
								{%- endif -%}
								{%- if settings.social_youtube_link != blank -%}
									<a href='{{ settings.social_youtube_link }}' class='footer__social-icon' target='_blank' rel='noopener' aria-label='YouTube'>
										<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor' width='13' height='13'><path d='M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z'/></svg>
									</a>
								{%- endif -%}
							</div>
						</div>

						{% assign linkListBlocks = section.blocks
							| where: 'type', 'link_list'
						%}
						{% assign contactsBlocks = section.blocks
							| where: 'type', 'contacts'
						%}
						{% assign socialBlocks = section.blocks
							| where: 'type', 'socials'
						%}

						{% if linkListBlocks.size > 0
							or contactsBlocks.size > 0
							or socialBlocks > 0
						%}
							<div class='footer--mid-wrapper'>
								{% for block in section.blocks %}
									{% if block.type == 'link_list' %}
										<div
											class='footer-block {% if block.settings.subheading != blank %}footer-block--menu{% endif %}'
											{{ block.shopify_attributes }}
										>
											{% if block.settings.subheading != blank %}
												<h2 class='footer-block__heading subtitle'>
													{{ block.settings.subheading | escape }}
												</h2>
											{% endif %}
											{% if block.settings.menu != blank
												and block.settings.subheading != blank
											%}
												<ul class='footer-block__details-content list-unstyled'>
													{% for link in block.settings.menu.links %}
														<li>
															<a
																href='{{ link.url }}'
																class='list-menu__item link-hover-line list-menu__item--link{% if link.active %} list-menu__item--active{% endif %} focus-inset'
															>
																{{ link.title }}
															</a>
														</li>
													{% endfor %}
												</ul>
											{% endif %}
										</div>
										{%- if block.settings.subheading != blank -%}
											<div class='accordion'>
												<details
													{% if block.settings.default_open %}
														open
													{% endif %}
												>
													<summary>
														<h2 class='footer-block__heading subtitle'>
															{{ block.settings.subheading | escape }}
														</h2>
														{% render 'icon-caret' %}
													</summary>
													{%- if block.settings.menu != blank -%}
														<ul class='footer-block__details-content list-unstyled'>
															{%- for link in block.settings.menu.links -%}
																<li>
																	<a
																		href='{{ link.url }}'
																		class='list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}'
																	>
																		<span>{{ link.title }}</span>
																	</a>
																</li>
															{%- endfor -%}
														</ul>
													{%- endif -%}
												</details>
											</div>
										{%- endif -%}
									{% elsif block.type == 'contacts' %}
										<div
											class='footer-block footer-block--menu contacts'
											{{ block.shopify_attributes }}
										>
											{% if block.settings.subheading != blank %}
												<p class='contacts__text footer-block__heading subtitle'>
													{{ block.settings.subheading }}
												</p>
											{% endif %}
											{% if block.settings.contact_info != blank %}
												<div class='footer-block__details-content list-unstyled'>
													<div class='list-menu__item link-hover-line list-menu__item--link focus-inset'>
														{{ block.settings.contact_info }}
													</div>
												</div>
											{% endif %}
										</div>

										{%- if block.settings.subheading != blank -%}
											<div class='accordion'>
												<details
													{% if block.settings.default_open %}
														open
													{% endif %}
												>
													<summary>
														<h2 class='footer-block__heading subtitle'>
															{{ block.settings.subheading | escape }}
														</h2>
														{% render 'icon-caret' %}
													</summary>
													<ul class='footer-block__details-content list-unstyled'>
														<li>
															{% if block.settings.contact_info != blank %}
																<div class='footer-block__details-content list-unstyled'>
																	{{ block.settings.contact_info }}
																</div>
															{% endif %}
														</li>
													</ul>
												</details>
											</div>
										{%- endif -%}
									{% elsif block.type == 'policies' %}
										<div
											class='footer-block footer-block--menu policies'
											{{ block.shopify_attributes }}
										>
											{% if block.settings.subheading != blank %}
												<p class='contacts__text footer-block__heading subtitle'>
													{{ block.settings.subheading }}
												</p>
											{% endif %}
											<ul class='footer-block__details-content list-unstyled'>
												{%- for policy in shop.policies -%}
													{%- if policy != blank -%}
														<li>
															<span class='copyright__content secondary_text'
																><a
																	href='{{ policy.url }}'
																	class='list-menu__item link-hover-line list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}'
																>
																	{{- policy.title -}}
																</a></span
															>
														</li>
													{%- endif -%}
												{%- endfor -%}
											</ul>
										</div>

										{%- if block.settings.subheading != blank -%}
											<div class='accordion'>
												<details
													{% if block.settings.default_open %}
														open
													{% endif %}
												>
													<summary>
														<h2 class='footer-block__heading subtitle'>
															{{ block.settings.subheading | escape }}
														</h2>
														{% render 'icon-caret' %}
													</summary>
													<ul class='footer-block__details-content list-unstyled'>
														{%- for policy in shop.policies -%}
															{%- if policy != blank -%}
