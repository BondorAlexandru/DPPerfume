<script>
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.querySelector('.romania-map-{{ section.id }}');
    const tooltip = container.querySelector('.county-tooltip');
    const counties = container.querySelectorAll('.county');
    
    const countyNames = {
      'satu-mare': 'Satu Mare',
      'arad': 'Arad',
      'bihor': 'Bihor',
      'timis': 'Timiș',
      'mehedinti': 'Mehedinți',
      'dolj': 'Dolj',
      'calarasi': 'Călărași',
      'teleorman': 'Teleorman',
      'giurgiu': 'Giurgiu',
      'constanta': 'Constanța',
      'olt': 'Olt',
      'caras-severin': 'Caraș-Severin',
      'botosani': 'Botoșani',
      'iasi': 'Iași',
      'vaslui': 'Vaslui',
      'galati': 'Galați',
      'suceava': 'Suceava',
      'maramures': 'Maramureș',
      'tulcea': 'Tulcea',
      'cluj': 'Cluj',
      'bistrita-nasaud': 'Bistrița-Năsăud',
      'salaj': 'Sălaj',
      'dambovita': 'Dâmbovița',
      'ilfov': 'Ilfov',
      'arges': 'Argeș',
      'gorj': 'Gorj',
      'hunedoara': 'Hunedoara',
      'valcea': 'Vâlcea',
      'prahova': 'Prahova',
      'covasna': 'Covasna',
      'vrancea': 'Vrancea',
      'buzau': 'Buzău',
      'brasov': 'Brașov',
      'sibiu': 'Sibiu',
      'mures': 'Mureș',
      'harghita': 'Harghita',
      'neamt': 'Neamț',
      'bacau': 'Bacău',
      'alba': 'Alba',
      'braila': 'Brăila',
      'ialomita': 'Ialomița',
      'bucharest': 'București'
    };
    
    counties.forEach(county => {
      county.addEventListener('mouseenter', function(e) {
        const countyId = this.getAttribute('data-county');
        const name = countyNames[countyId] || countyId;
        tooltip.textContent = name;
        tooltip.classList.add('visible');
      });
      
      county.addEventListener('mousemove', function(e) {
        tooltip.style.left = e.clientX + 'px';
        tooltip.style.top = e.clientY + 'px';
      });
      
      county.addEventListener('mouseleave', function() {
        tooltip.classList.remove('visible');
      });
      
      county.addEventListener('click', function() {
        const countyId = this.getAttribute('data-county');
        const allGroups = document.querySelectorAll('.city-group');
        const target = document.querySelector('.city-group[data-county="' + countyId + '"]');

        allGroups.forEach(function(g) { g.classList.remove('open'); });

        if (target) {
          target.classList.add('open');
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  });
</script>

