{%- style -%}
  .romania-map-{{ section.id }} {
    padding: 40px 20px;
    background: white;
  }
  .romania-map-{{ section.id }} .map-container {
    max-width: 800px;
    margin: 0 auto;
  }
  .romania-map-{{ section.id }} .map-svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .romania-map-{{ section.id }} .county {
    cursor: pointer;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .romania-map-{{ section.id }} .county:hover {
    filter: brightness(0.88);
  }
  .romania-map-{{ section.id }} .no-stores {
    fill: #FAFAFA;
  }
  .romania-map-{{ section.id }} .has-stores {
    fill: #E8915B;
  }
  .romania-map-{{ section.id }} .county-tooltip {
    position: fixed;
    background: #333;
    color: #fff;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    z-index: 1000;
    white-space: nowrap;
    transform: translate(-50%, -100%);
    margin-top: -10px;
  }
  .romania-map-{{ section.id }} .county-tooltip.visible {
    opacity: 1;
  }
  @media screen and (max-width: 750px) {
    .romania-map-{{ section.id }} .map-container {
      max-width: 100%;
      padding: 0 10px;
    }
  }
{%- endstyle -%}

