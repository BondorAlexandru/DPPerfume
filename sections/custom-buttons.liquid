{%- liquid
  assign heading = section.settings.heading
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<div
  class="custom-buttons"
  style="padding-top: {{ padding_top }}px; padding-bottom: {{ padding_bottom }}px;"
>
  <div class="container">
    {%- if heading != blank -%}
      <h2 class="custom-buttons__heading">{{ heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="custom-buttons__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' -%}
            {%- liquid
              assign label = block.settings.label
              assign link = block.settings.link
              assign style_variant = block.settings.style
              assign new_tab = block.settings.open_new_tab
            -%}
            {%- if label != blank -%}
              <a
                href="{{ link | default: '#' }}"
                class="button button--{{ style_variant }} focus-inset custom-buttons__btn"
                {% if new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                {{ block.shopify_attributes }}
              >
                {{ label | escape }}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .custom-buttons__heading {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }

  .custom-buttons__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .custom-buttons__btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom buttons",
  "tag": "section",
  "class": "section custom-buttons-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)",
      "info": "Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Click me"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Button style",
          "options": [
            { "value": "primary",   "label": "Primary (filled black)" },
            { "value": "secondary", "label": "Secondary" },
            { "value": "tertiary",  "label": "Tertiary (outlined)" }
          ],
          "default": "primary"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom buttons",
      "blocks": [
        { "type": "button" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
