{% doc %}
  @prompt
    Create a section with a 3d perfume bottle model rotating on the left side, taking up 50% of the width, and on the right taking the other 50% of the width, a header text with body copy and CTA button, make the 3d model responsive, so when you click and drag you can rotate the bottle manually, also add a field to upload my own 3d model, can you also give me a field where i can see the custom CSS code for this section, so i can adjust things manually in the code?
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-perfume-3d-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-perfume-3d-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    gap: 40px;
  }

  .ai-perfume-3d-model-wrapper-{{ ai_gen_id }} {
    flex: 0 0 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 500px;
    position: relative;
  }

  .ai-perfume-3d-model-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    perspective: 1000px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    user-select: none;
  }

  .ai-perfume-3d-model-{{ ai_gen_id }}.dragging {
    cursor: grabbing;
  }

  .ai-perfume-3d-model-canvas-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-perfume-bottle-{{ ai_gen_id }} {
    width: {{ block.settings.bottle_width }}px;
    height: {{ block.settings.bottle_height }}px;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 0.1s ease-out;
  }

  .ai-perfume-bottle-{{ ai_gen_id }}.auto-rotate {
    animation: ai-perfume-rotate-{{ ai_gen_id }} {{ block.settings.rotation_speed }}s linear infinite;
  }

  .ai-perfume-bottle-face-{{ ai_gen_id }} {
    position: absolute;
    width: 100%;
    height: 100%;
    background: {{ block.settings.bottle_gradient }};
    border: 2px solid {{ block.settings.bottle_border_color }};
    border-radius: {{ block.settings.bottle_border_radius }}px;
    opacity: {{ block.settings.bottle_opacity }};
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .ai-perfume-bottle-front-{{ ai_gen_id }} {
    transform: translateZ({{ block.settings.bottle_depth | divided_by: 2 }}px);
  }

  .ai-perfume-bottle-back-{{ ai_gen_id }} {
    transform: rotateY(180deg) translateZ({{ block.settings.bottle_depth | divided_by: 2 }}px);
  }

  .ai-perfume-bottle-left-{{ ai_gen_id }} {
    width: {{ block.settings.bottle_depth }}px;
    transform: rotateY(-90deg) translateZ({{ block.settings.bottle_depth | divided_by: 2 }}px);
  }

  .ai-perfume-bottle-right-{{ ai_gen_id }} {
    width: {{ block.settings.bottle_depth }}px;
    transform: rotateY(90deg) translateZ(calc({{ block.settings.bottle_width }}px - {{ block.settings.bottle_depth | divided_by: 2 }}px));
  }

  .ai-perfume-bottle-top-{{ ai_gen_id }} {
    height: {{ block.settings.bottle_depth }}px;
    transform: rotateX(90deg) translateZ({{ block.settings.bottle_depth | divided_by: 2 }}px);
  }

  .ai-perfume-bottle-bottom-{{ ai_gen_id }} {
    height: {{ block.settings.bottle_depth }}px;
    transform: rotateX(-90deg) translateZ(calc({{ block.settings.bottle_height }}px - {{ block.settings.bottle_depth | divided_by: 2 }}px));
  }

  .ai-perfume-bottle-cap-{{ ai_gen_id }} {
    position: absolute;
    top: -{{ block.settings.cap_height }}px;
    left: 50%;
    transform: translateX(-50%);
    width: {{ block.settings.cap_width }}px;
    height: {{ block.settings.cap_height }}px;
    background: {{ block.settings.cap_color }};
    border-radius: {{ block.settings.cap_border_radius }}px {{ block.settings.cap_border_radius }}px 0 0;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
  }

  .ai-perfume-bottle-label-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 600;
    text-align: center;
    z-index: 1;
  }

  .ai-perfume-custom-model-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    max-width: {{ block.settings.bottle_width }}px;
    max-height: {{ block.settings.bottle_height }}px;
    object-fit: contain;
  }

  .ai-perfume-model-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    max-width: {{ block.settings.bottle_width }}px;
    max-height: {{ block.settings.bottle_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    position: relative;
  }

  .ai-perfume-model-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-perfume-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @keyframes ai-perfume-rotate-{{ ai_gen_id }} {
    0% {
      transform: rotateY(0deg) rotateX({{ block.settings.tilt_angle }}deg);
    }
    100% {
      transform: rotateY(360deg) rotateX({{ block.settings.tilt_angle }}deg);
    }
  }

  .ai-perfume-3d-content-{{ ai_gen_id }} {
    flex: 0 0 50%;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-perfume-3d-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    margin: 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  .ai-perfume-3d-body-{{ ai_gen_id }} {
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-perfume-3d-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_border_color }};
    cursor: pointer;
    align-self: flex-start;
  }

  .ai-perfume-3d-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 989px) {
    .ai-perfume-3d-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 40px;
    }

    .ai-perfume-3d-model-wrapper-{{ ai_gen_id }},
    .ai-perfume-3d-content-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
    }

    .ai-perfume-3d-model-wrapper-{{ ai_gen_id }} {
      min-height: 400px;
    }

    .ai-perfume-3d-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-perfume-3d-body-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.body_size }}px * 0.9);
    }
  }

  {{ block.settings.custom_css }}
{% endstyle %}

<perfume-3d-section-{{ ai_gen_id }} class="ai-perfume-3d-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-perfume-3d-container-{{ ai_gen_id }}">
    <div class="ai-perfume-3d-model-wrapper-{{ ai_gen_id }}">
      <div class="ai-perfume-3d-model-{{ ai_gen_id }}" data-model-type="{{ block.settings.model_type }}">
        {% if block.settings.model_type == 'custom' and block.settings.custom_model_file != blank %}
          <div class="ai-perfume-3d-model-canvas-{{ ai_gen_id }}">
            <model-viewer
              class="ai-perfume-custom-model-{{ ai_gen_id }}"
              src="{{ block.settings.custom_model_file }}"
              alt="3D Model"
              auto-rotate
              camera-controls
              rotation-per-second="{{ 360 | divided_by: block.settings.rotation_speed }}deg"
            ></model-viewer>
          </div>
        {% elsif block.settings.model_type == 'custom' %}
          <div class="ai-perfume-model-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-perfume-empty-state-{{ ai_gen_id }}">
              Upload a 3D model file (.glb or .gltf)
            </div>
          </div>
        {% else %}
          <div class="ai-perfume-3d-model-canvas-{{ ai_gen_id }}">
            <div class="ai-perfume-bottle-{{ ai_gen_id }} auto-rotate">
              <div class="ai-perfume-bottle-cap-{{ ai_gen_id }}"></div>
              <div class="ai-perfume-bottle-face-{{ ai_gen_id }} ai-perfume-bottle-front-{{ ai_gen_id }}">
                {% if block.settings.label_text != blank %}
                  <div class="ai-perfume-bottle-label-{{ ai_gen_id }}">{{ block.settings.label_text }}</div>
                {% endif %}
              </div>
              <div class="ai-perfume-bottle-face-{{ ai_gen_id }} ai-perfume-bottle-back-{{ ai_gen_id }}"></div>
              <div class="ai-perfume-bottle-face-{{ ai_gen_id }} ai-perfume-bottle-left-{{ ai_gen_id }}"></div>
              <div class="ai-perfume-bottle-face-{{ ai_gen_id }} ai-perfume-bottle-right-{{ ai_gen_id }}"></div>
              <div class="ai-perfume-bottle-face-{{ ai_gen_id }} ai-perfume-bottle-top-{{ ai_gen_id }}"></div>
              <div class="ai-perfume-bottle-face-{{ ai_gen_id }} ai-perfume-bottle-bottom-{{ ai_gen_id }}"></div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-perfume-3d-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-perfume-3d-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.body_text != blank %}
        <div class="ai-perfume-3d-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-perfume-3d-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</perfume-3d-section-{{ ai_gen_id }}>

<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.3.0/model-viewer.min.js"></script>

<script>
  (function() {
    class Perfume3DSection{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
        this.isDragging = false;
        this.startX = 0;
        this.startY = 0;
        this.currentRotationY = 0;
        this.currentRotationX = {{ block.settings.tilt_angle }};
      }

      connectedCallback() {
        this.modelWrapper = this.querySelector('.ai-perfume-3d-model-{{ ai_gen_id }}');
        this.bottle = this.querySelector('.ai-perfume-bottle-{{ ai_gen_id }}');
        this.modelType = this.modelWrapper.getAttribute('data-model-type');

        if (this.modelType === 'default' && this.bottle) {
          this.setupDragControls();
        }
      }

      setupDragControls() {
        this.modelWrapper.addEventListener('mousedown', this.handleMouseDown.bind(this));
        this.modelWrapper.addEventListener('touchstart', this.handleTouchStart.bind(this), { passive: false });
        
        document.addEventListener('mousemove', this.handleMouseMove.bind(this));
        document.addEventListener('touchmove', this.handleTouchMove.bind(this), { passive: false });
        
        document.addEventListener('mouseup', this.handleMouseUp.bind(this));
        document.addEventListener('touchend', this.handleTouchEnd.bind(this));
      }

      handleMouseDown(e) {
        this.startDrag(e.clientX, e.clientY);
      }

      handleTouchStart(e) {
        if (e.touches.length === 1) {
          e.preventDefault();
          this.startDrag(e.touches[0].clientX, e.touches[0].clientY);
        }
      }

      startDrag(x, y) {
        this.isDragging = true;
        this.startX = x;
        this.startY = y;
        this.modelWrapper.classList.add('dragging');
        this.bottle.classList.remove('auto-rotate');
      }

      handleMouseMove(e) {
        if (this.isDragging) {
          this.drag(e.clientX, e.clientY);
        }
      }

      handleTouchMove(e) {
        if (this.isDragging && e.touches.length === 1) {
          e.preventDefault();
          this.drag(e.touches[0].clientX, e.touches[0].clientY);
        }
      }

      drag(x, y) {
        const deltaX = x - this.startX;
        const deltaY = y - this.startY;

        this.currentRotationY += deltaX * 0.5;
        this.currentRotationX -= deltaY * 0.3;

        this.currentRotationX = Math.max(-30, Math.min(30, this.currentRotationX));

        this.bottle.style.transform = `rotateY(${this.currentRotationY}deg) rotateX(${this.currentRotationX}deg)`;

        this.startX = x;
        this.startY = y;
      }

      handleMouseUp() {
        this.endDrag();
      }

      handleTouchEnd() {
        this.endDrag();
      }

      endDrag() {
        if (this.isDragging) {
          this.isDragging = false;
          this.modelWrapper.classList.remove('dragging');
        }
      }
    }

    customElements.define('perfume-3d-section-{{ ai_gen_id }}', Perfume3DSection{{ai_gen_id}});
  })();
</script>

