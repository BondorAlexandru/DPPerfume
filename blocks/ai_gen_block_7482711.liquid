{% doc %}
  @prompt
    i want a divider with a different off-white colour to separate the section, with 3 text items displayed at equal distances, horizontally, each with a header and body copy
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-divider-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.divider_background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-divider-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-divider-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.gap }}px;
    align-items: start;
  }

  .ai-divider-item-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-divider-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-weight: 600;
  }

  .ai-divider-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-divider-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-divider-item-{{ ai_gen_id }} {
      text-align: {{ block.settings.mobile_text_alignment }};
    }
  }
{% endstyle %}

<div class="ai-divider-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-divider-container-{{ ai_gen_id }}">
    <div class="ai-divider-content-{{ ai_gen_id }}">
      <div class="ai-divider-item-{{ ai_gen_id }}">
        {% if block.settings.heading_1 != blank %}
          <h3 class="ai-divider-heading-{{ ai_gen_id }}">{{ block.settings.heading_1 }}</h3>
        {% endif %}
        {% if block.settings.text_1 != blank %}
          <div class="ai-divider-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</div>
        {% endif %}
      </div>

      <div class="ai-divider-item-{{ ai_gen_id }}">
        {% if block.settings.heading_2 != blank %}
          <h3 class="ai-divider-heading-{{ ai_gen_id }}">{{ block.settings.heading_2 }}</h3>
        {% endif %}
        {% if block.settings.text_2 != blank %}
          <div class="ai-divider-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</div>
        {% endif %}
      </div>

      <div class="ai-divider-item-{{ ai_gen_id }}">
        {% if block.settings.heading_3 != blank %}
          <h3 class="ai-divider-heading-{{ ai_gen_id }}">{{ block.settings.heading_3 }}</h3>
        {% endif %}
        {% if block.settings.text_3 != blank %}
          <div class="ai-divider-text-{{ ai_gen_id }}">{{ block.settings.text_3 }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text divider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "divider_background_color",
      "label": "Background color",
      "default": "#fafaf8"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Container width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap between items",
      "default": 40
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading",
      "default": "Free Shipping"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Text",
      "default": "On all orders over 100 RON"
    },
    {
      "type": "header",
      "content": "Item 2"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading",
      "default": "Easy Returns"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Text",
      "default": "30-day return policy"
    },
    {
      "type": "header",
      "content": "Item 3"
    },
    {
      "type": "text",
      "id": "heading_3",
      "label": "Heading",
      "default": "Secure Payment"
    },
    {
      "type": "textarea",
      "id": "text_3",
      "label": "Text",
      "default": "100% secure transactions"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 18
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Heading spacing",
      "default": 8
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4d4d4d"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Gap between items",
      "default": 30
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Text divider"
    }
  ]
}
{% endschema %}
