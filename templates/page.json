    "rich_text_ykqTgU": {
      "type": "rich-text",
      "blocks": {
        "heading_cPBrWH": {
          "type": "heading",
          "settings": {
            "heading": "8. Prețurile",
            "heading_size": "h1"
          }
        },
        "text_dzKHeh": {
          "type": "text",
          "settings": {
            "text": "<p>Toate prețurile afișate pe site-ul www.dpparfum.ro includ TVA și sunt prețuri finale. Prețurile sunt valabile la data plasării comenzii. În cazul în care prețul unui produs se modifică după plasarea comenzii, clientul va fi notificat și va avea opțiunea de a confirma sau anula comanda.</p><p>Fotografiile produselor prezentate pe site sunt doar pentru prezentare și pot diferi ușor de aspectul real al produsului.</p>"
          }
        }
      },
      "block_order": [
