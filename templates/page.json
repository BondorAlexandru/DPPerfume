    "rich_text_YydkAA": {
      "type": "rich-text",
      "blocks": {
        "heading_4kQpyz": {
          "type": "heading",
          "settings": {
            "heading": "5. Modalități de plată",
            "heading_size": "h1"
          }
        },
        "text_JVffXz": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Plată la livrare (ramburs):</strong> Produsele pot fi achitate în numerar la momentul livrării, cu chitanță.</p><p><strong>Plată online cu card bancar:</strong> Plata se efectuează online prin intermediul unui sistem securizat de procesare a plăților cu card bancar (debit/credit).</p><p><strong>Plăți online prin Netopia mobilpay:</strong> Clientul poate efectua plata prin intermediul platformei Netopia mobilpay, care oferă o modalitate sigură și convenabilă de plată online.</p>"
          }
        }
      },
