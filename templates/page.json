        "text_Y768km": {
          "type": "text",
          "settings": {
            "text": "<p>Vizitarea, folosirea și cumpărarea produselor de pe site-ul www.dpparfum.ro presupune acceptarea în totalitate și de fiecare dată când accesați site-ul a Termenilor și Condițiilor sub care funcționează acest website și sistemul de livrare al produselor.</p>"
          }
        }
