        },
        "text_mqRzLM": {
          "type": "text",
          "settings": {
            "text": "<p>Parfumurile D&P pot fi comandate online pe www.dpparfum.ro sau cumpărate din <a href=\"https://www.dpparfum.ro/magazinele-noastre/\" target=\"_blank\"><strong>magazinele D&P</strong></a> prezente în București, Baia Mare, Brașov, Botoșani, Buzău, Constanța, Craiova, Drobeta Turnu Severin, Focșani, Iași, Petroșani, Pitești, Ploiești, Râmnicu Vâlcea, Târgoviște și Sibiu. Lista magazinelor D&P poate fi găsită aici.</p>"
