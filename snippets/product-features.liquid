<div class="product-features" {{ block.shopify_attributes }} style="width: 100%; padding: 10px; justify-content: flex-start; align-items: flex-start; gap: 24px; display: inline-flex; flex-wrap: wrap;">
  <div style="flex-direction: column; justify-content: flex-start; align-items: flex-start; gap: 2px; display: inline-flex">
    <div style="color: #4D4D4D; font-size: 10px; font-family: Open Sans; font-weight: 400; text-transform: uppercase; line-height: 16.20px; letter-spacing: 0.65px;">{{ block.settings.scent_heading }}:</div>
    <div style="color: black; font-size: 15.40px; font-family: Open Sans; font-weight: 400; line-height: 20.02px;">{{ block.settings.scent_text }}</div>
  </div>
  <div style="flex-direction: column; justify-content: flex-start; align-items: flex-start; gap: 2px; display: inline-flex">
    <div style="color: #4D4D4D; font-size: 10px; font-family: Open Sans; font-weight: 400; text-transform: uppercase; line-height: 16.20px; letter-spacing: 0.65px;">{{ block.settings.occasion_heading }}:</div>
    <div style="color: black; font-size: 15.40px; font-family: Open Sans; font-weight: 400; line-height: 20.02px;">{{ block.settings.occasion_text }}</div>
  </div>
  <div style="flex-direction: column; justify-content: flex-start; align-items: flex-start; gap: 2px; display: inline-flex">
    <div style="color: #4D4D4D; font-size: 10px; font-family: Open Sans; font-weight: 400; text-transform: uppercase; line-height: 16.20px; letter-spacing: 0.65px;">{{ block.settings.intensity_heading }}:</div>
    <div style="color: black; font-size: 15.40px; font-family: Open Sans; font-weight: 400; line-height: 20.02px;">{{ block.settings.intensity_text }}</div>
  </div>
  <div style="flex-direction: column; justify-content: flex-start; align-items: flex-start; gap: 2px; display: inline-flex">
    <div style="color: #4D4D4D; font-size: 10px; font-family: Open Sans; font-weight: 400; text-transform: uppercase; line-height: 16.20px; letter-spacing: 0.65px;">{{ block.settings.persistence_heading }}:</div>
    <div style="color: black; font-size: 15.40px; font-family: Open Sans; font-weight: 400; line-height: 20.02px;">{{ block.settings.persistence_text }}</div>
  </div>
</div>
