{% comment %}
  Renders the free-shipping cart progress bar (AOV booster).

  Single reward tier, configured in Theme settings > Cart:
    settings.min_spend → Free shipping ("Transport Gratuit")

  All state/copy logic lives in CartItems.cartShipping() (assets/cart.js); this
  snippet only renders the markup + data attributes the script reads. The outer
  `.cart-shipping` class is kept so existing section selectors keep matching.

  Usage:
    {% render 'cart-rewards-bar' %}
{% endcomment %}

{%- if settings.show_shipping -%}
  <div
    class="cart-shipping cart-rewards"
    data-total="{{ cart.total_price }}"
    data-min-spend="{{ settings.min_spend | times: 100.0 }}"
    data-message="{{ settings.message_shipping | strip | escape }}"
    data-message-complete="{{ settings.message_shipping_free | strip | escape }}"
  >
    <div class="cart-rewards__tiers">
      <div class="cart-rewards__tier cart-rewards__tier--shipping">
        <span class="cart-rewards__tier-icon">
          <svg class="cart-rewards__icon-reward" viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true">
            <path d="M2 13h11V6H3a1 1 0 0 0-1 1v6zm11-4h4l3 4v3h-2M4 17h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="6.5" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="17.5" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <svg class="cart-rewards__icon-check" viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true">
            <path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="cart-rewards__tier-label">{{ settings.reward_label_shipping | default: 'Transport Gratuit' }}</span>
      </div>
    </div>

    <span class="cart-shipping__progress cart-rewards__bar">
      <span class="cart-shipping__progress-current"></span>
    </span>

    <p class="cart-shipping__message cart-rewards__message secondary_text active" role="status" aria-live="polite"></p>
  </div>
{%- endif -%}
