<div class="info-dropdown-block__item {% if open_by_default %}open{% endif %}">
  <button class="info-dropdown-block__header" aria-expanded="{{ open_by_default }}" onclick="this.parentElement.classList.toggle('open'); this.setAttribute('aria-expanded', this.parentElement.classList.contains('open'))">
    <h3 class="info-dropdown-block__title h3">{{ title }}</h3>
    <div class="info-dropdown-block__toggle">
      <span class="toggle-plus">+</span>
      <span class="toggle-minus">&mdash;</span>
    </div>
  </button>
  <div class="info-dropdown-block__content">
    <div class="info-dropdown-block__content-inner">
      {%- if content != blank -%}
        <div class="rte">{{ content }}</div>
      {%- endif -%}
    </div>
  </div>
</div>
