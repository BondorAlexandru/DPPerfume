																						width: block.settings.image_4.width,
																						class: 'mega-menu__item-image'
																				}}
																			{%  else %}
																				{{ "hero-apparel-3" | placeholder_svg_tag: 'placeholder-svg' }}
																			{%- endif -%}
																		</div>
																		{% if block.settings.heading_4 != blank %}
																			<div class="mega-menu__item-heading subtitle">
																				{{ block.settings.heading_4 }}
																			</div>
																		{%- endif -%}
																		{% if block.settings.button_link_4 != blank %}
																			<a
																				href="{{ block.settings.button_link_4 }}"
																				class="mega-menu__item-button link link--overlay"
																			>
																			</a>
																		{% endif %}
																	</div>
																{% endif %}

																{% assign mega_menu_promo_5_trigger = block.settings.mega_menu_promo_5_trigger
																	| handle
																	| strip
																%}

																{% if item.handle == mega_menu_promo_5_trigger %}
																	<div class="mega-menu__item">
																		<div class="mega-menu__item-image-wrapper">
																			{% if block.settings.image_5 != blank %}
																				{{
																					block.settings.image_5
																					| image_url:
																						width: block.settings.image_5.width
																					| image_tag:
																						loading: 'lazy',
																						sizes: '100vw',
																						widths: '360, 550, 710',
																						width: block.settings.image_5.width,
																						class: 'mega-menu__item-image'
																				}}
																			{%  else %}
																				{{ "hero-apparel-3" | placeholder_svg_tag: 'placeholder-svg' }}
																			{%- endif -%}
																		</div>
																		{% if block.settings.heading_5 != blank %}
																			<div class="mega-menu__item-heading subtitle">
																				{{ block.settings.heading_5 }}
																			</div>
																		{%- endif -%}
																		{% if block.settings.button_link_5 != blank %}
																			<a
																				href="{{ block.settings.button_link_5 }}"
																				class="mega-menu__item-button link link--overlay"
																			>
																			</a>
																		{% endif %}
																	</div>
																{% endif %}
															{% endif %}
														{% endfor %}
													</div>
												</div>
											</div>
										</details>
									</menu-drawer>
								{%- else -%}
									<a
										href="{{ item.url }}"
										{% if settings.links_blank and item.type == 'http_link' %}
											target="_blank"
										{% endif %}
										class="burger-menu__item burger-menu__link link-hover-line body-xl h3"
									>
										<span>{{ item.title }}</span>
									</a>
								{%- endif -%}
							</li>
						{%- endfor -%}
					{%- endif -%}
				</ul>
				{% endif %}
				{% for block in blocks %}
					{% assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip %}
					{% assign show_block = false %}
					{% if link.handle == mega_menu_trigger %}
						{% if block.settings.first_product != blank or block.settings.first_collection != blank or block.settings.second_product != blank or block.settings.second_collection != blank %}
							{%liquid
								assign show_block = true
								assign media_size = block.settings.block_image_ratio
							%}
						{% endif %}
					{% endif %}
					{% if link.handle == mega_menu_trigger and show_block == true %}
						{% if block.settings.first_product != blank or block.settings.first_collection != blank or block.settings.second_product != blank or block.settings.second_collection != blank %}
							<div id="burger-menu-images-block__{{ link.handle }}" class="burger-menu__list burger-menu__list-second burger-menu__list-images-wrapper {% if enable_dropdown_menu == true %}burger-menu__list-images-horizontal{% endif %}">
								{% if block.settings.first_product != blank or block.settings.first_collection != blank %}
									{%liquid
										assign fisrt_product = block.settings.first_product
										assign fisrt_collection = block.settings.first_collection
									%}
									<div class="burger-menu__list-image-wrapper">
										<div class="burger-menu__horizontal-image" tabindex="-1">
											<div class="media"
												{%- if media_size == 'landscape' -%}
													style="padding-bottom: 70%;"
												{%- endif -%}
												{%- if media_size == 'portrait' -%}
													style="padding-bottom: 125%;"
												{%- endif -%}
												{%- if media_size == 'square' -%}
													style="padding-bottom: 100%;"
												{%- endif -%}
											>
												{% if fisrt_product != blank %}
													{%- if fisrt_product.featured_media -%}
														{{
																fisrt_product.featured_media
																| image_url:
																	width: fisrt_product.featured_media.width
																| image_tag:
																	loading: 'lazy',
																	class: 'media--item',
																	widths: '180, 260, 550, 750, 1100',
																	sizes: '100vw'
															}}
													{%- else -%}
														{{ 'product-apparel-' | append: loop_index | placeholder_svg_tag: 'placeholder-svg' }}
													{%- endif -%}
												{%- else -%}
													{%- if fisrt_collection.featured_image -%}
														{{
																fisrt_collection.featured_image
																| image_url:
																	width: fisrt_collection.featured_image.width
																| image_tag:
																	loading: 'lazy',
																	class: 'media--item',
																	widths: '180, 260, 550, 750, 1100',
																	sizes: '100vw'
															}}
													{%- else -%}
														{{ 'product-apparel-' | append: loop_index | placeholder_svg_tag: 'placeholder-svg' }}
													{%- endif -%}
												{%- endif -%}
											</div>
										</div>
										<h3 class="burger-menu__image-title">
											{% if fisrt_product != blank %}
												{% if fisrt_product.title != blank %}
													<a class="full-unstyled-link" href="{{ fisrt_product.url | default: '#' }}" title="{{ fisrt_product.title | escape }}">
														{{ fisrt_product.title | escape }}
													</a>
												{% else %}
													<span class="full-unstyled-link">{{ 'products.product.product_heading' | t }}</span>
												{% endif %}
											{%- else -%}
												{% if fisrt_collection.title != blank %}
													<a class="full-unstyled-link" href="{{ fisrt_collection.url | default: '#' }}" title="{{ fisrt_collection.title | escape }}">
														{{ fisrt_collection.title | escape }}
													</a>
												{% else %}
													<span class="full-unstyled-link">{{ 'general.card.collection_name' | t }}</span>
												{% endif %}
											{%- endif -%}
										</h3>
									</div>
								{% endif %}
								{% if block.settings.second_product != blank or block.settings.second_collection != blank %}
									<div class="burger-menu__list-image-wrapper">
										{%liquid
											assign second_product = block.settings.second_product
											assign second_collection = block.settings.second_collection
										%}
										<div class="burger-menu__list-image-wrapper">
											<div class="burger-menu__horizontal-image" tabindex="-1">
												<div class="media"
													{%- if media_size == 'landscape' -%}
														style="padding-bottom: 70%;"
													{%- endif -%}
													{%- if media_size == 'portrait' -%}
														style="padding-bottom: 125%;"
													{%- endif -%}
													{%- if media_size == 'square' -%}
														style="padding-bottom: 100%;"
													{%- endif -%}
												>
													{% if second_product != blank %}
														{%- if second_product.featured_media -%}
															{{
																	second_product.featured_media
																	| image_url:
																		width: second_product.featured_media.width
																	| image_tag:
																		loading: 'lazy',
																		class: 'media--item',
																		widths: '180, 260, 550, 750, 1100',
																		sizes: '100vw'
																}}
														{%- else -%}
															{{ 'product-apparel-' | append: loop_index | placeholder_svg_tag: 'placeholder-svg' }}
														{%- endif -%}
													{%- else -%}
														{%- if second_collection.featured_image -%}
															{{
																	second_collection.featured_image
																	| image_url:
																		width: second_collection.featured_image.width
																	| image_tag:
																		loading: 'lazy',
																		class: 'media--item',
																		widths: '180, 260, 550, 750, 1100',
																		sizes: '100vw'
																}}
														{%- else -%}
															{{ 'product-apparel-' | append: loop_index | placeholder_svg_tag: 'placeholder-svg' }}
														{%- endif -%}
													{%- endif -%}
												</div>
											</div>
											<h3 class="burger-menu__image-title">
												{% if second_product != blank %}
													{% if second_product.title != blank %}
														<a class="full-unstyled-link" href="{{ second_product.url | default: '#' }}" title="{{ second_product.title | escape }}">
															{{ second_product.title | escape }}
														</a>
													{% else %}
														<span class="full-unstyled-link">{{ 'products.product.product_heading' | t }}</span>
													{% endif %}
												{%- else -%}
													{% if second_collection.title != blank %}
														<a class="full-unstyled-link" href="{{ second_collection.url | default: '#' }}" title="{{ second_collection.title | escape }}">
															{{ second_collection.title | escape }}
														</a>
													{% else %}
														<span class="full-unstyled-link">{{ 'general.card.collection_name' | t }}</span>
													{% endif %}
												{%- endif -%}
											</h3>
										</div>
									</div>
								{% endif %}
							</div>
						{% endif %}
					{% else %}
					{% assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip %}
					{% if link.handle == mega_menu_trigger %}
						{% if block.settings.small_menu != blank %}
							<ul
								class="burger-menu__list burger-menu__list-second list-unstyled"
								role="list"
							>
								{%- for link in block.settings.small_menu.links -%}
									<li>
										{%- if link != blank -%}
											<a
												href="{{ link.url }}"
												class=" burger-menu__item burger-menu__link link-hover-line body-xl h3"
												{% if settings.links_blank and link.type == 'http_link' %}
													target="_blank"
												{% endif %}
												{% if link.current %}
													aria-current="page"
												{% endif %}
											>
												<span>
													{{ link.title | escape }}
												</span>
											</a>
										{% endif %}
									</li>
								{% endfor %}
							</ul>
						{% endif %}
					{% endif %}
					{% endif %}
				{% endfor %}
				{% if enable_dropdown_menu == true %}
					</div>
				{% endif %}
			</div>
			<div class="burger-menu__bottom">
				{% for block in blocks %}
					{% assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip %}
					{% if link.handle == mega_menu_trigger %}
						{% if block.settings.mega_menu_description != blank %}
							<div class="mega_menu_description secondary_text">{{ block.settings.mega_menu_description }}</div>
						{% endif %}
						{%- if block.settings.mega_menu_button_label != blank -%}
							<a
								{% if block.settings.mega_menu_button_link != blank %}
									href="{{ block.settings.mega_menu_button_link }}"
								{% endif %}
								class="block-heading__button button button--{{ block.settings.mega_menu_button_style }} focus-inset"
								{% if block.settings.mega_menu_button_link == blank %}
									aria-disabled="true"
								{% endif %}
							>
								<span>
									{{- block.settings.mega_menu_button_label | escape -}}
								</span>
							</a>
						{%- endif -%}
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</div>
</burger-menu>
