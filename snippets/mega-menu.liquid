{% liquid
	assign open_menu_on_hover = false
	assign enable_dropdown_menu = false
	assign media_size = 'landscape'

	for block in blocks
		assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip
		if link.handle == mega_menu_trigger and block.settings.enable_dropdown_menu == true
				assign enable_dropdown_menu = true
		endif
		if link.handle == mega_menu_trigger and block.settings.enable_dropdown_submenu == true
				assign enable_dropdown_submenu = true
		endif
		if link.handle == mega_menu_trigger and block.settings.enable_dropdown_menu == true and block.settings.open_dropdown_menu == 'on_hover'
			assign open_menu_on_hover = true
		endif
	endfor
%}
<burger-menu {{ block.shopify_attributes }} data-open-on-hover="{% if open_menu_on_hover %}true{% else %}false{% endif %}">
	{% if open_menu_on_hover == false %}
		<button
			class="mega-menu__toggle burger-menu__toggle burger-menu__toggle--open-btn button--unstyled focus-inset no-js-hidden"
			aria-label="{{ 'sections.header.burger_menu_open' | t }}"
		>
			<span class="list-menu-line link-hover-line">
				{{- link.title | escape -}}
			</span>
		</button>
	{% elsif open_menu_on_hover == true %}
		<a
			href='{{ link.url }}'
			class='header__menu-item list-menu__item link focus-inset burger-menu__hover--open-btn {%- if link.active %} header__active-menu-item{% endif %}'
			{% if settings.links_blank and link.type == 'http_link' %}
				target="_blank"
			{% endif %}
			{% if link.current %}
				aria-current='page'
			{% endif %}
			aria-label='{{ link.title | escape }}'
		>
			<span
				class='list-menu-line link-hover-line'
				title='{{ link.title | escape }}'
			>
				{{ link.title | escape }}
			</span>
		</a>
	{% endif %}

	<div class="burger-menu">
		<div class="burger-menu__overlay"></div>
		<div
			class="burger-menu__wrapper color-background-1 {% if enable_dropdown_menu == true %}burger-menu__dropdown-wrapper{% endif %} {% if open_menu_on_hover == true %}burger-menu__on-hover{% endif %}"
			role="dialog"
			aria-modal="true"
			aria-label="{{ 'sections.header.burger_menu' | t }}"
			tabindex="-1"
		>
			<div class="burger-menu__top">
				<div class="burger-menu__header">
					<button
						type="button"
						class="burger-menu__toggle burger-menu__toggle--close-btn modal-close-button focus-inset"
						aria-label="{{ 'accessibility.close' | t }}"
					>
						{% render 'icon-close' %}
					</button>
				</div>
				{% if enable_dropdown_menu == true %}
					<div class="burger-menu__dropdown_menu_wrapper">
				{% endif %}
				{% if enable_dropdown_menu == true and enable_dropdown_submenu == true %}
					<div class="menu-drawer__dropdown-submenu" >
						 <div
							id="link-{{ link.title | escape }}"
							class="menu-drawer__submenu motion-reduce {% if mega_menu_blocks == true %}menu-drawer__submenu--hidden{% endif %}"
							tabindex="-1"
						>
							<div class="menu-drawer__inner-submenu">
								<button
									class="menu-drawer__close-button link link--text focus-inset"
									aria-expanded="true"
								>
									{% render 'icon-arrow' %}
									{{ link.title | escape }}
								</button>
								<ul
									class="menu-drawer__menu list-menu"
									role="list"
									tabindex="-1"
								>
									{%- for childlink in link.links -%}
									<li>
										{%- if childlink.links == blank -%}
										<a
											href="{{ childlink.url }}"
											class="menu-drawer__menu-item h3 link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
											{% if settings.links_blank and childlink.type == 'http_link' %}
												target="_blank"
											{% endif %}
											{% if childlink.current %}
											aria-current="page"
											{% endif %}
										>
											{{ childlink.title | escape }}
										</a>
										{%- else -%}
										<details>
											<summary class="menu-drawer__menu-item link--text list-menu__item focus-inset h3">
												{{ childlink.title | escape }}
												{% render 'icon-caret' %}
											</summary>
											<div
												id="childlink-{{ link.title }}-{{ childlink.title | escape }}"
												class="menu-drawer__submenu motion-reduce"
											>
											<button
												class="menu-drawer__close-button link link--text focus-inset"
												aria-expanded="true"
											>
												{% render 'icon-arrow' %}
												{{ childlink.title | escape }}
											</button>
											<ul
												class="menu-drawer__menu list-menu"
												role="list"
												tabindex="-1"
											>
												{%- for grandchildlink in childlink.links -%}
												<li>
													<a
														href="{{ grandchildlink.url }}"
														class="menu-drawer__menu-item h3 link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
														{% if settings.links_blank and grandchildlink.type == 'http_link' %}
															target="_blank"
														{% endif %}
														{% if grandchildlink.current %}
															aria-current="page"
														{% endif %}
													>
														{{ grandchildlink.title | escape }}
													</a>
												</li>
												{%- endfor -%}
											</ul>
											{% for block in section.blocks %}
												{% assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip %}
												{% if link.handle == mega_menu_trigger %}
													{% assign mega_menu_promo_1_trigger = block.settings.mega_menu_promo_1_trigger
													| handle
													| strip
													%}
													{% liquid
														assign mega_menu_promo_trigger_1 = block.settings.mega_menu_promo_1_trigger | handle | strip
														assign mega_menu_promo_trigger_2 = block.settings.mega_menu_promo_2_trigger | handle | strip
														assign mega_menu_promo_trigger_3 = block.settings.mega_menu_promo_3_trigger | handle | strip
														assign mega_menu_promo_trigger_4 = block.settings.mega_menu_promo_4_trigger | handle | strip
														assign mega_menu_promo_trigger_5 = block.settings.mega_menu_promo_5_trigger | handle | strip
													%}
													{% if childlink.handle == mega_menu_promo_trigger_1 or childlink.handle == mega_menu_promo_trigger_2 or clink.handle == mega_menu_promo_trigger_3 or childlink.handle == mega_menu_promo_trigger_4 or lchildlink.handle == mega_menu_promo_trigger_5 %}
														<div class="mega-menu__items">
															{% if childlink.handle == mega_menu_promo_1_trigger %}
																<div class="mega-menu__item">
																<div class="mega-menu__item-image-wrapper">
																	{% if block.settings.image_1 != blank %}
																	{{
																		block.settings.image_1
																		| image_url:
																		width: block.settings.image_1.width
																		| image_tag:
																		loading: 'lazy',
																		sizes: '100vw',
																		widths: '360, 550, 710',
																		width: block.settings.image_1.width,
																		class: 'mega-menu__item-image'
																	}}
																	{%  else %}
																		{{ "hero-apparel-1" | placeholder_svg_tag: 'placeholder-svg' }}
																	{%- endif -%}
																</div>
																
																{% if block.settings.heading_1 != blank %}
																	<div class="mega-menu__item-heading subtitle">
																		{{ block.settings.heading_1 }}
																	</div>
																{%- endif -%}
																{% if block.settings.button_link_1 != blank %}
																	<a
																		href="{{ block.settings.button_link_1 }}"
																		class="mega-menu__item-button link link--overlay"
																	>
																	</a>
																{% endif %}
																</div>
															{% endif %}

															{% assign mega_menu_promo_2_trigger = block.settings.mega_menu_promo_2_trigger
																| handle
																| strip
															%}
														
															{% if childlink.handle == mega_menu_promo_2_trigger %}
																<div class="mega-menu__item">
																	<div class="mega-menu__item-image-wrapper">
																		{% if block.settings.image_2 != blank %}
																			{{
																				block.settings.image_2
																				| image_url:
																				width: block.settings.image_2.width
																				| image_tag:
																				loading: 'lazy',
																				sizes: '100vw',
																				widths: '360, 550, 710',
																				width: block.settings.image_2.width,
																				class: 'mega-menu__item-image'
																			}}
																		{%  else %}
																			{{ "hero-apparel-2" | placeholder_svg_tag: 'placeholder-svg' }}
																		{%- endif -%}
																	</div>
																	{% if block.settings.heading_2 != blank %}
																		<div class="mega-menu__item-heading subtitle">
																			{{ block.settings.heading_2 }}
																		</div>
																	{%- endif -%}
																	{% if block.settings.button_link_2 != blank %}
																		<a
																			href="{{ block.settings.button_link_2 }}"
																			class="mega-menu__item-button link link--overlay"
																		>
																		</a>
																	{% endif %}
																</div>
															{% endif %}

															{% assign mega_menu_promo_3_trigger = block.settings.mega_menu_promo_3_trigger
																| handle
																| strip
															%}

															{% if childlink.handle == mega_menu_promo_3_trigger %}
																<div class="mega-menu__item">
																	<div class="mega-menu__item-image-wrapper">
																		{% if block.settings.image_3 != blank %}
																			{{
																				block.settings.image_3
																				| image_url:
																				width: block.settings.image_3.width
																				| image_tag:
																				loading: 'lazy',
																				sizes: '100vw',
																				widths: '360, 550, 710',
																				width: block.settings.image_3.width,
																				class: 'mega-menu__item-image'
																			}}
																		{%  else %}
																			{{ "hero-apparel-3" | placeholder_svg_tag: 'placeholder-svg' }}
																		{%- endif -%}
																	</div>
																	{% if block.settings.heading_3 != blank %}
																		<div class="mega-menu__item-heading subtitle">
																			{{ block.settings.heading_3 }}
																		</div>
																	{%- endif -%}
																	{% if block.settings.button_link_3 != blank %}
																		<a
																			href="{{ block.settings.button_link_3 }}"
																			class="mega-menu__item-button link link--overlay"
																		>
																		</a>
																	{% endif %}
																</div>
															{% endif %}

															{% assign mega_menu_promo_4_trigger = block.settings.mega_menu_promo_4_trigger
																| handle
																| strip
															%}

															{% if childlink.handle == mega_menu_promo_4_trigger %}
																<div class="mega-menu__item">
																	<div class="mega-menu__item-image-wrapper">
																		{% if block.settings.image_4 != blank %}
																			{{
																				block.settings.image_4
																				| image_url:
																				width: block.settings.image_4.width
																				| image_tag:
																				loading: 'lazy',
																				sizes: '100vw',
																				widths: '360, 550, 710',
																				width: block.settings.image_4.width,
																				class: 'mega-menu__item-image'
																			}}
																		{%  else %}
																			{{ "hero-apparel-3" | placeholder_svg_tag: 'placeholder-svg' }}
																		{%- endif -%}
																	</div>
																{% if block.settings.heading_4 != blank %}
																	<div class="mega-menu__item-heading subtitle">
																		{{ block.settings.heading_4 }}
																	</div>
																{%- endif -%}
																{% if block.settings.button_link_4 != blank %}
																	<a
																		href="{{ block.settings.button_link_4 }}"
																		class="mega-menu__item-button link link--overlay"
																	>
																	</a>
																{% endif %}
																</div>
															{% endif %}

															{% assign mega_menu_promo_5_trigger = block.settings.mega_menu_promo_5_trigger
																| handle
																| strip
															%}

															{% if childlink.handle == mega_menu_promo_5_trigger %}
																<div class="mega-menu__item">
																	<div class="mega-menu__item-image-wrapper">
																		{% if block.settings.image_5 != blank %}
																			{{
																				block.settings.image_5
																				| image_url:
																				width: block.settings.image_5.width
																				| image_tag:
																				loading: 'lazy',
																				sizes: '100vw',
																				widths: '360, 550, 710',
																				width: block.settings.image_5.width,
																				class: 'mega-menu__item-image'
																			}}
																		{%  else %}
																			{{ "hero-apparel-3" | placeholder_svg_tag: 'placeholder-svg' }}
																		{%- endif -%}
																	</div>
																	{% if block.settings.heading_5 != blank %}
																		<div class="mega-menu__item-heading subtitle">
																			{{ block.settings.heading_5 }}
																		</div>
																	{%- endif -%}
																	{% if block.settings.button_link_5 != blank %}
																		<a
																			href="{{ block.settings.button_link_5 }}"
																			class="mega-menu__item-button link link--overlay"
																		>
																		</a>
																	{% endif %}
																</div>
															{% endif %}
														</div>
													{% endif %}
												{% endif %}
											{% endfor %}
											</div>
										</details>
										{%- endif -%}
									</li>
									{%- endfor -%}
								</ul>
							</div>
						</div>
					</div>
				{% else %}
				<ul class="burger-menu__list h3" role="list">
					{% if section.settings.menu.links != blank %}
						{% for item in link.links %}
							<li>
								{% if item.links != blank %}
									<menu-drawer>
										<details id="Details-BurgerMenu-Link-{{ forloop.index }}">
											<summary
												class="burger-menu__item burger-menu__summary"
											>
												<span class="burger-menu__link body-xl h3 link-hover-line">
													{{- item.title | escape -}}
												</span>

												<div class="burger-menu__arrow">
													{% render 'icon-caret-right-burger' %}
												</div>
											</summary>
											<div
												id="link-{{ forloop.index }}-{{ item.title | escape }}"
												class="burger-menu__submenu"
												tabindex="-1"
											>
												<div class="burger-menu__submenu-inner">
													<div class="burger-menu__header">
														<button
															type="button"
															class="burger-menu__submenu-back modal-close-button focus-inset"
															aria-label="{{ 'accessibility.back' | t }}"
															aria-expanded="true"
														>
															{% render 'icon-caret-left-burger' %}
														</button>
														<span> {{ item.title }} </span>
														<button
															type="button"
															class="burger-menu__toggle burger-menu__toggle--close-btn modal-close-button focus-inset"
															aria-label="{{ 'accessibility.close' | t }}"
														>
															{% render 'icon-close' %}
														</button>
													</div>
													<ul
														class="burger-menu__list h3"
														role="list"
														tabindex="-1"
													>
														{% for childlink in item.links %}
															<li>
																<a
																	href="{{ childlink.url }}"
																	class="burger-menu__item burger-menu__link link-hover-line body-xl h3"
																	{% if settings.links_blank and childlink.type == 'http_link' %}
																		target="_blank"
																	{% endif %}
																	{% if childlink.current %}
																		aria-current="page"
																	{% endif %}
																>
																	<span>{{ childlink.title | escape }}</span>
																</a>
															</li>
														{% endfor %}
													</ul>
													<div class="mega-menu__items">
														{% for block in section.blocks %}
															{% assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip %}
															{% if link.handle == mega_menu_trigger %}
																{% assign mega_menu_promo_1_trigger = block.settings.mega_menu_promo_1_trigger
																	| handle
																	| strip
																%}
																
																{% if item.handle == mega_menu_promo_1_trigger %}
																	<div class="mega-menu__item">
																		<div class="mega-menu__item-image-wrapper">
																			{% if block.settings.image_1 != blank %}
																				{{
																					block.settings.image_1
																					| image_url:
																						width: block.settings.image_1.width
																					| image_tag:
																						loading: 'lazy',
																						sizes: '100vw',
																						widths: '360, 550, 710',
																						width: block.settings.image_1.width,
																						class: 'mega-menu__item-image'
																				}}
																			{%  else %}
																				{{ "hero-apparel-1" | placeholder_svg_tag: 'placeholder-svg' }}
																			{%- endif -%}
																		</div>
																		
																		{% if block.settings.heading_1 != blank %}
																			<div class="mega-menu__item-heading subtitle">
																				{{ block.settings.heading_1 }}
																			</div>
																		{%- endif -%}
																		{% if block.settings.button_link_1 != blank %}
																			<a
																				href="{{ block.settings.button_link_1 }}"
																				class="mega-menu__item-button link link--overlay"
																			>
																			</a>
																		{% endif %}
																	</div>
																{% endif %}

																{% assign mega_menu_promo_2_trigger = block.settings.mega_menu_promo_2_trigger
																	| handle
																	| strip
																%}
																
																{% if item.handle == mega_menu_promo_2_trigger %}
																	<div class="mega-menu__item">
																		<div class="mega-menu__item-image-wrapper">
																			{% if block.settings.image_2 != blank %}
																				{{
																					block.settings.image_2
																					| image_url:
																						width: block.settings.image_2.width
																					| image_tag:
																						loading: 'lazy',
																						sizes: '100vw',
																						widths: '360, 550, 710',
																						width: block.settings.image_2.width,
																						class: 'mega-menu__item-image'
																				}}
																			{%  else %}
																				{{ "hero-apparel-2" | placeholder_svg_tag: 'placeholder-svg' }}
																			{%- endif -%}
																		</div>
																		{% if block.settings.heading_2 != blank %}
																			<div class="mega-menu__item-heading subtitle">
																				{{ block.settings.heading_2 }}
																			</div>
																		{%- endif -%}
																		{% if block.settings.button_link_2 != blank %}
																			<a
																				href="{{ block.settings.button_link_2 }}"
																				class="mega-menu__item-button link link--overlay"
																			>
																			</a>
																		{% endif %}
																	</div>
																{% endif %}

																{% assign mega_menu_promo_3_trigger = block.settings.mega_menu_promo_3_trigger
																	| handle
																	| strip
																%}

																{% if item.handle == mega_menu_promo_3_trigger %}
																	<div class="mega-menu__item">
																		<div class="mega-menu__item-image-wrapper">
																			{% if block.settings.image_3 != blank %}
																				{{
																					block.settings.image_3
																					| image_url:
																						width: block.settings.image_3.width
																					| image_tag:
																						loading: 'lazy',
																						sizes: '100vw',
																						widths: '360, 550, 710',
																						width: block.settings.image_3.width,
																						class: 'mega-menu__item-image'
																				}}
																			{%  else %}
																				{{ "hero-apparel-3" | placeholder_svg_tag: 'placeholder-svg' }}
																			{%- endif -%}
																		</div>
																		{% if block.settings.heading_3 != blank %}
																			<div class="mega-menu__item-heading subtitle">
																				{{ block.settings.heading_3 }}
																			</div>
																		{%- endif -%}
																		{% if block.settings.button_link_3 != blank %}
																			<a
																				href="{{ block.settings.button_link_3 }}"
																				class="mega-menu__item-button link link--overlay"
																			>
																			</a>
																		{% endif %}
																	</div>
																{% endif %}

																{% assign mega_menu_promo_4_trigger = block.settings.mega_menu_promo_4_trigger
																	| handle
																	| strip
																%}

																{% if item.handle == mega_menu_promo_4_trigger %}
																	<div class="mega-menu__item">
																		<div class="mega-menu__item-image-wrapper">
																			{% if block.settings.image_4 != blank %}
																				{{
